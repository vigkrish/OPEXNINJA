NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/opexninja_dev

# JWT
JWT_SECRET=your-super-secret-key-change-in-production
JWT_EXPIRATION=24h
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRATION=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# OPEX AI Company dashboard control plane
# Use a long random value in production. Required for pause/resume/run-now and task-state changes.
AI_COMPANY_CONTROL_KEY=replace-with-a-long-random-control-key
